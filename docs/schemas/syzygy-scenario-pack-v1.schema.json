{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syzygy.penumbra.invalid/schemas/scenario-pack-v1.schema.json",
  "title": "Syzygy Portable Scenario Pack v1",
  "description": "Open interchange contract for reusable scenario authoring state. Passing this schema alone does not verify the checksum, canonical ordering, unique nested IDs, current-turn projection, or a closed acyclic parent graph; conforming readers must enforce those semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "packId", "title", "description", "license", "source", "scenarios", "checksum"],
  "properties": {
    "format": { "const": "syzygy-scenario-pack" },
    "schemaVersion": { "const": 1 },
    "packId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/title" },
    "description": { "$ref": "#/$defs/longText" },
    "license": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000]+$" },
        { "type": "null" }
      ]
    },
    "source": { "$ref": "#/$defs/source" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/scenario" },
      "$comment": "Runtime requires unique scenario IDs, ascending ID order, and a closed acyclic parent graph."
    },
    "checksum": { "$ref": "#/$defs/checksum" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "timestamp": { "type": "number", "minimum": 0 },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000]+$"
    },
    "longText": { "type": "string", "maxLength": 20000, "pattern": "^[^\\u0000]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "documentId", "projectTitle", "exportedBy", "exportedByDisplayName", "exportedAt"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "documentId": { "$ref": "#/$defs/id" },
        "projectTitle": { "$ref": "#/$defs/title" },
        "exportedBy": { "$ref": "#/$defs/id" },
        "exportedByDisplayName": { "$ref": "#/$defs/title" },
        "exportedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "syzygy-json-v1" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "$comment": "value is SHA-256 over UTF-8 syzygy-json-v1 canonical JSON of the complete envelope with checksum omitted."
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "title", "background", "status", "parentScenarioId", "createdBy", "createdAt", "turns", "edits"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "background": { "type": "string", "maxLength": 50000, "pattern": "^[^\\u0000]*$" },
        "status": { "enum": ["draft", "ready", "archived"] },
        "parentScenarioId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "createdBy": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "turns": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/turn" },
          "$comment": "Array order is the authored turn order; turn IDs must be unique within the scenario."
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/edit" },
          "$comment": "Runtime requires unique edit IDs and ascending timestamp/editId/authorId canonical order."
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdBy", "createdAt", "role", "content", "revisions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdBy": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "role": { "$ref": "#/$defs/role" },
        "content": { "$ref": "#/$defs/turnContent" },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/revision" },
          "$comment": "Runtime requires unique edit IDs, canonical order, and role/content equal to the final revision."
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editId", "role", "content", "authorId", "timestamp"],
      "properties": {
        "editId": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/role" },
        "content": { "$ref": "#/$defs/turnContent" },
        "authorId": { "$ref": "#/$defs/id" },
        "timestamp": { "$ref": "#/$defs/timestamp" }
      }
    },
    "role": { "enum": ["system", "user", "assistant"] },
    "turnContent": { "type": "string", "maxLength": 200000, "pattern": "^[^\\u0000]*$" },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editId", "authorId", "timestamp", "fields", "changes"],
      "properties": {
        "editId": { "$ref": "#/$defs/id" },
        "authorId": { "$ref": "#/$defs/id" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["title", "background", "status"] }
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 3,
          "properties": {
            "title": { "$ref": "#/$defs/title" },
            "background": { "type": "string", "maxLength": 50000, "pattern": "^[^\\u0000]*$" },
            "status": { "enum": ["draft", "ready", "archived"] }
          }
        }
      },
      "$comment": "Runtime requires fields to name exactly the keys present in changes."
    }
  }
}
